# Copy this file to .env and fill in values for your deployment.
# Every variable here has a default in app/config.py, but the defaults
# point at Stellar testnet with no contract configured — you must set at
# least STELLAR_BRIDLE_CONTRACT_ID and STELLAR_RELAYER_SECRET_KEY to run
# the relay endpoint for real.
#
# NOTE: pydantic-settings matches env vars to Settings fields case-
# insensitively by field name (e.g. `bridle_contract_id` <-> BRIDLE_CONTRACT_ID).

# --- Stellar / Soroban -------------------------------------------------------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
BRIDLE_CONTRACT_ID=

# --- Relayer signing key ------------------------------------------------------
# Secret seed (starts with S) for the backend's own fee-paying Stellar
# account. It submits transactions and pays their network fee; it never
# authorizes a spend or a transfer itself — only the agent's own key can
# (see README "Auth model"). Fund it with just enough XLM to cover fees.
RELAYER_SECRET_KEY=

# --- Database ------------------------------------------------------------------
# Defaults to a local SQLite file; point this at Postgres for production
# (e.g. postgresql+asyncpg://user:pass@host:5432/bridle) with no code changes.
DATABASE_URL=sqlite+aiosqlite:///./bridle.db

# --- Tuning --------------------------------------------------------------------
POLICY_CACHE_TTL_SECONDS=2.0
AUTH_ENTRY_VALIDITY_LEDGERS=60
SYNC_POLL_INTERVAL_SECONDS=5.0
SYNC_WORKER_ENABLED=true
REQUEST_TIMEOUT_SECONDS=8.0

# --- HTTP ------------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API (e.g. the dashboard's URL).
CORS_ALLOW_ORIGINS=*
